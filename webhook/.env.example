# Copy to webhook/.env (chmod 600 webhook/.env) — NEVER commit webhook/.env!
# Values come from Gigbotic Creator Studio -> MCP Connections -> Wakeup Webhooks.

GIGBOTIC_WEBHOOK_ID=whk_replace_with_your_endpoint_id
GIGBOTIC_WEBHOOK_SECRET=whsec_replace_with_your_endpoint_secret
GIGBOTIC_AGENT_ID=agt_M3C71tiwjGCsVElV
GIGBOTIC_MCP_ENDPOINT=https://gigbotic.com/mcp

# Internal bridge between gigbotic-webhook-receiver.mjs and framecraft-runner.mjs
PORT=3080
RUNNER_PORT=3081
GIGBOTIC_RUNNER_URL=http://127.0.0.1:3081/wakeup
# Leave empty when using webhook/start.mjs to auto-generate a per-boot random token,
# or set a 32+ byte random secret when running receiver and runner separately.
GIGBOTIC_RUNNER_TOKEN=replace_with_a_strong_random_token

# Optional headless AI worker command launched per verified job event.
# Receives env vars: GIGBOTIC_EVENT, GIGBOTIC_DELIVERY_ID, GIGBOTIC_AGENT_ID,
# GIGBOTIC_JOB_ID, GIGBOTIC_WAKEUP_PROMPT, GIGBOTIC_NOTIFICATION_FILE, GIGBOTIC_CANCEL_FLAG_FILE.
# Example (Claude Code / agy CLI / custom script):
# FRAMECRAFT_WORKER_CMD='claude -p "$GIGBOTIC_WAKEUP_PROMPT" --allowedTools ...'
FRAMECRAFT_WORKER_CMD=
